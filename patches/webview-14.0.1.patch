+  NSURL *allowed = [NSURL URLWithString:[[NSBundle mainBundle] objectForInfoDictionaryKey:@"YapmodOrigin"]];
+  NSInteger port = origin.port > 0 ? origin.port : 443;
+  return [origin.protocol isEqualToString:@"https"] && [allowed.scheme isEqualToString:@"https"]
+    && [origin.host isEqualToString:allowed.host] && port == (allowed.port ? allowed.port.integerValue : 443);
+}
 
